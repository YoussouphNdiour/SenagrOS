DATABASE_URL=postgresql://postgres:postgres@localhost:5432/senagros
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# Sentinel Hub (Copernicus Data Space) — NDVI satellite imagery
# Créer un client OAuth sur https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
# Flow: CLIENT_CREDENTIALS
SENTINEL_HUB_CLIENT_ID=sh-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SENTINEL_HUB_CLIENT_SECRET=

# Vérification périodique des chutes de NDVI, exécutée dans le processus
# applicatif (aucun point d'entrée HTTP n'est exposé pour cela).
# Désactivée par défaut : elle consomme du quota Sentinel Hub.
# NDVI_ALERT_SCHEDULE=on
# NDVI_ALERT_INTERVAL_HOURS=24

# Storefront payments (Phase 13). Without these, outside production, payments go
# through the local simulation page /checkout/paiement-simule.
# Wave Checkout API — https://docs.wave.com/checkout
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
# Orange Money WebPay — sandbox URL by default (currency OUV), set the /sn/ URL in production
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
# ORANGE_MONEY_WEBPAY_URL=https://api.orange.com/orange-money-webpay/dev/v1/webpayment
